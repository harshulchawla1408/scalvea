# =========================
# Generated CSS artifacts
# =========================
# critical-extracted.css is a one-off extraction artifact, not inlined by the build
critical-extracted.css
# src/critical.css is the compiled output written by build-critical-css.mjs
# The authoritative source is src/index.css — regenerated on each build
src/critical.css

# =========================
# Generated responsive images
# =========================
# These are regenerated on every build by scripts/generate-responsive-images.mjs
# from the originals in src/assets/*.webp
# Do NOT commit these; a clean checkout regenerates them via `npm run build`
src/assets/generated/

# =========================
# Bundle visualiser report & build caches
# =========================
dist/stats.html
dist/.template.html